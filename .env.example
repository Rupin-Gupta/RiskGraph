# Copy to .env and fill in values. .env is gitignored; never commit or print keys.

# FRED API key (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Password for the local Postgres container (docker-compose.yml)
POSTGRES_PASSWORD=

# Phase 02 agents (ADR-012): Gemini API free tier, key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override llm.model_id in configs/agents.yaml
LLM_MODEL_ID=
# Only if llm.provider is bedrock (ADR-009); Bedrock uses the standard AWS profile credentials.
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
AWS_REGION=ap-south-1
# HMAC key for human-approval tokens (any long random string, e.g. `openssl rand -hex 32`)
APPROVAL_SECRET=

# Langfuse tracing (optional; tracing is off when these are empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional: adds a trace link to each incident in the API and dashboard
LANGFUSE_PROJECT_ID=

# Phase 03 API: bearer token for POST /runs/daily (e.g. `openssl rand -hex 24`)
API_TOKEN=
# Escalation dispatch: file (writes data/runs/<date>/escalations/) or ses (also emails via SES)
DISPATCH_MODE=file
# Only for DISPATCH_MODE=ses: SES-verified addresses (sandbox verification is fine)
SES_SENDER=
SES_RECIPIENT=

# Phase 03 deployment
# Basic auth for the deployed dashboard (infra/aws/secrets.sh copies these into Secrets Manager)
BASIC_AUTH_USER=riskgraph
BASIC_AUTH_PASSWORD=
# MLflow (from phase 05) writes artifacts to the S3 artifacts bucket
MLFLOW_ARTIFACT_ROOT=s3://riskgraph-artifacts-3b8acac5/mlflow
